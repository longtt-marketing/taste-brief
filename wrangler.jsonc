{
  "name": "taste-brief",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Secrets (never in git): npx wrangler secret put QLOO_API_KEY / ANTHROPIC_API_KEY
  // Local dev without keys runs on synthetic data: npx wrangler dev --var MOCK:1
  // Run near the US: Anthropic refuses calls from some Cloudflare locations near Vietnam (403 "Request not allowed",
  // seen 20/10 from the Hong Kong colo), while the same key works from Vietnam.
  "placement": { "region": "aws:us-east-1" },
  // Free live runs per day without the access code (src/worker.js); the count lives in this KV namespace.
  "kv_namespaces": [{ "binding": "QUOTA", "id": "daaccaa3ddf8419799c074617dd23871" }],
  // the deployed version id goes into each run's record, so a run can be traced to the code that made it
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": { "MOCK": "0", "FREE_DAILY": "25" }
}
